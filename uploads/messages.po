#. App name shown in the title bar
#: src/app.py:12
msgid "My App"
msgstr "Mon App"

#. Version string shown in settings, %s = version number
#: src/app.py:15
msgid "Version %s"
msgstr "Version %s"

#. Title on the onboarding welcome screen
#: src/onboarding.py:8
msgid "Welcome to My App"
msgstr "Bienvenue sur Mon App"

#. Subtitle on the onboarding welcome screen
#: src/onboarding.py:9
msgid "The best app for managing your tasks"
msgstr "La meilleure application pour gérer vos tâches"

#. Button label to start onboarding
#: src/onboarding.py:20
msgid "Get Started"
msgstr "Commencer"

#. Button label to skip onboarding
#: src/onboarding.py:21
msgid "Skip"
msgstr "Passer"

#. Title of the login screen
#: src/auth.py:30
msgid "Sign In"
msgstr "Se connecter"

#. Placeholder for the email input field
#: src/auth.py:35
msgid "Email address"
msgstr "Adresse e-mail"

#. Placeholder for the password input field
#: src/auth.py:36
msgid "Password"
msgstr "Mot de passe"

#. Forgot password link text
#: src/auth.py:50
msgid "Forgot password?"
msgstr "Mot de passe oublié ?"

#. Sign out button
#: src/auth.py:80
msgid "Sign Out"
msgstr "Se déconnecter"

#. Greeting on the home screen, %s = user's first name
#: src/home.py:10
msgid "Hello, %s!"
msgstr "Bonjour, %s !"

#. Empty state message on home screen
#: src/home.py:25
msgid "No tasks yet. Tap + to add one."
msgstr "Aucune tâche. Appuyez sur + pour en ajouter une."

#. Task count label, supports pluralization
#: src/home.py:40
msgid "%d task remaining"
msgid_plural "%d tasks remaining"
msgstr[0] "%d tâche restante"
msgstr[1] "%d tâches restantes"

#. Generic error message
#: src/errors.py:5
msgid "Something went wrong. Please try again."
msgstr "Quelque chose s'est mal passé. Veuillez réessayer."

#. Shown when there is no internet connection
#: src/errors.py:10
msgid "No internet connection."
msgstr "Pas de connexion internet."

#. Validation error for invalid email
#: src/errors.py:15
msgid "Please enter a valid email address."
msgstr "Veuillez entrer une adresse e-mail valide."

#. Generic buttons
#: src/ui/buttons.py:5
msgid "OK"
msgstr "OK"

#: src/ui/buttons.py:6
msgid "Cancel"
msgstr "Annuler"

#: src/ui/buttons.py:7
msgid "Save"
msgstr "Enregistrer"

#: src/ui/buttons.py:8
msgid "Delete"
msgstr "Supprimer"

#: src/ui/buttons.py:9
msgid "Done"
msgstr "Terminé"

#: src/ui/buttons.py:10
msgid "Retry"
msgstr "Réessayer"
